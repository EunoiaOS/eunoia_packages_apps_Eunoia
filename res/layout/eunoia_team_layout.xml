<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/pref_min_height"
    android:layout_marginHorizontal="@dimen/pref_horizontal_margin"
    android:layout_marginVertical="@dimen/pref_vertical_margin"
    android:paddingHorizontal="@dimen/pref_horizontal_padding"
    android:paddingVertical="@dimen/pref_vertical_padding"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/information_icon"
        android:layout_width="@dimen/pref_icon_size"
        android:layout_height="@dimen/pref_icon_size"
        android:tint="@color/pref_inline_icon" />

    <TextView
        android:id="@+id/information_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/eunoia_text_primary" />

    <TextView
        android:id="@+id/information_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/eunoia_text_primary" />

</LinearLayout>
